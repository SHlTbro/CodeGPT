      "responseFields": {
        "project_id": true,
        "truncated": "结果超 100 时 true（find_references/workspace_symbols/get_diagnostics）"
      },
      "errors": [
        "PROJECT_NOT_FOUND",
        "INVALID_ARGUMENT",
        "PATH_OUTSIDE_WORKSPACE",
        "FILE_NOT_VISIBLE",
        "LSP_UNAVAILABLE"
      ],
      "notes": "行号对外 1-based（内部转 LSP 0-based）"
    },
    {
      "name": "find_references",
      "description": "查找光标处符号的全部引用位置（含/不含声明可选）。",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "input": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "character": {
            "type": "integer",
            "minimum": 1
          },
          "include_declaration": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "project_id",
          "path",
          "line",
          "character"
