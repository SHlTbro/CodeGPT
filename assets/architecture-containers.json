  "cards": [
    {
      "dot": "cyan",
      "title": "职责与技术",
      "items": [
        "浏览器页面调用 Setup 的 JSON API；Setup 持有配置事务与进程生命周期。",
        "Local MCP 是独立 FastMCP 进程，读取同一份 TOML，调用受约束的文件工具。"
      ]
    },
    {
      "dot": "rose",
      "title": "持久化与隔离",
      "items": [
        "配置文件是数据存储，不是新增服务；失败回退 last-good 并重新验证后端。",
        "隧道进程只指向 MCP；不存在隧道到 Setup 的访问边。可选公网能力不等于当前会话已经连接。"
      ]
    }
